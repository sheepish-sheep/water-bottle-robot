<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>water_bottle_robot</name>
  <version>0.1.0</version>
  <description>Stretch takes a water bottle from a person, drives to a fountain, fills it and brings it back.</description>
  <maintainer email="noreply@example.com">water-bottle-robot team</maintainer>
  <license>TODO: License declaration</license>

  <!-- Hello Robot (built in ~/ament_ws) -->
  <exec_depend>hello_helpers</exec_depend>
  <exec_depend>stretch_core</exec_depend>
  <exec_depend>stretch_description</exec_depend>
  <exec_depend>stretch_nav2</exec_depend>
  <exec_depend>stretch_simulation</exec_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- pip-only, not declared: mujoco + stretch_mujoco (sim), stretch_body (preinstalled
       on the robot), opencv/mediapipe/ultralytics (perception). -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
